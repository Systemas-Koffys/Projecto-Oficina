{
  "Acciones.xlsx": [
    {
      "acciones": "Poda de Formación – Corte de ramas secas, elevacion de copa y despeje de pantalla ."
    },
    {
      "acciones": "Despunte - Poda de reducción de copa, reducción controlada del tamaño del árbol para evitar riesgos."
    },
    {
      "acciones": "Derribe Controlado – Eliminación total del árbol por riesgo, daño estructural, arbol seco, arbol podrido y arbol inclinado."
    },
    {
      "acciones": "Emergencia - Arbol caido o por caer, arbol seco, arbol podrido y arbol muy inclinado."
    },
    {
      "acciones": "Poda de Raíces – Corte de raíces que afectan pavimentos o estructuras cercanas."
    },
    {
      "acciones": "Extracción de Tocón – Remoción del tronco y raíces después de la tala para evitar brotes o plagas."
    },
    {
      "acciones": "Poda General y otros segun criterio tecnico.(levantado de copa, despeje de pantalla, despunte, derribe)"
    },
    {
      "acciones": "No Determinado"
    }
  ],
